{
  "manifest_version": 3,
  "name": "Lead Scraper",
  "version": "1.0.0",
  "description": "Extract leads from Maps, Facebook, LinkedIn, WhatsApp",
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.ts"]
    }
  ],
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
