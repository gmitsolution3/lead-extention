          <Loader2 className="h-4 w-4 animate-spin" />
          Stop Extraction
        </button>
      )}

      {/* Status banners */}
      {status === 'done' && (
        <div className="flex items-center gap-2.5 text-xs text-emerald-300 bg-[#1c1c1e] border border-emerald-500/30 rounded-xl px-3.5 py-2.5 font-medium shadow-xs">
