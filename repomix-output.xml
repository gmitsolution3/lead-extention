<file path="src/content/index.ts">
import { scrapeGoogleMaps } from './mapsScraper';
import { scrapeGenericPage } from './genericScraper';

try {
  let isExtracting = false;
  console.log('[LeadScraper] Content script loaded on:', window.location.href);

  // ── Main orchestrator ──────────────────────────────────────────────────────
  async function startScrapeProcess() {
    const isMaps =
      window.location.hostname.includes('google.com') &&
      window.location.pathname.includes('/maps');
    if (isMaps) {
      await scrapeGoogleMaps(() => isExtracting);
    } else {
      await scrapeGenericPage();
    }
  }

  // ── Message listener ───────────────────────────────────────────────────────
  chrome.runtime.onMessage.addListener((req: any, _sender, sendResponse: any) => {
    try {
      if (req.action === 'PING') {
        sendResponse({ alive: true, url: window.location.href });
        return true;
      }
      if (req.action === 'START_SCRAPING') {
        if (isExtracting) {
          sendResponse({ status: 'already_running' });
          return true;
        }
        isExtracting = true;
        startScrapeProcess()
          .catch((err) => {
            console.error('[LeadScraper] Error:', err);
            chrome.runtime.sendMessage(
              { type: 'EXTRACTION_ERROR', message: String(err?.message || err) },
              () => {
                if (chrome.runtime.lastError) {
                  /* ignore */
                }
              }
            );
          })
          .finally(() => {
            isExtracting = false;
            chrome.runtime.sendMessage({ type: 'EXTRACTION_DONE' }, () => {
              if (chrome.runtime.lastError) {
                /* ignore */
              }
            });
          });
        sendResponse({ status: 'started' });
        return true;
      }
      if (req.action === 'STOP_EXTRACTION') {
        isExtracting = false;
        sendResponse({ status: 'stopped' });
        return true;
      }
    } catch (e) {
      console.warn('[LeadScraper] Listener error:', e);
    }
  });
} catch (globalErr) {
  console.warn('[LeadScraper] Init error:', globalErr);
}
</file>

<file path="src/App.tsx">
import { useExtraction } from '@/hooks/useExtraction';
import { Header } from '@/components/Header';
import { SearchControls } from '@/components/SearchControls';
import { LeadsList } from '@/components/LeadsList';
import { ExportFooter } from '@/components/ExportFooter';

function App() {
  const {
    status,
    errorMsg,
    query,
    setQuery,
    leads,
    platform,
    platformColor,
    filterText,
    setFilterText,
    filterNoWebsiteOnly,
    setFilterNoWebsiteOnly,
    filteredLeads,
    noWebsiteCount,
    isExtracting,
    handleStart,
    handleStop,
    handleClear,
    handleExportCSV,
    handleExportXML,
  } = useExtraction();

  return (
    <div className="w-[420px] min-h-[580px] bg-[#121212] text-zinc-100 font-sans flex flex-col antialiased selection:bg-[#c6f432] selection:text-black">
      <Header platform={platform} platformColor={platformColor} />

      <SearchControls
        query={query}
        setQuery={setQuery}
        isExtracting={isExtracting}
        status={status}
        errorMsg={errorMsg}
        leadsCount={leads.length}
        handleStart={handleStart}
        handleStop={handleStop}
      />

      <LeadsList
        leads={leads}
        filteredLeads={filteredLeads}
        noWebsiteCount={noWebsiteCount}
        filterNoWebsiteOnly={filterNoWebsiteOnly}
        setFilterNoWebsiteOnly={setFilterNoWebsiteOnly}
        filterText={filterText}
        setFilterText={setFilterText}
        handleClear={handleClear}
        isExtracting={isExtracting}
      />

      <ExportFooter
        handleExportCSV={handleExportCSV}
        handleExportXML={handleExportXML}
        disabled={leads.length === 0 || isExtracting}
      />
    </div>
  );
}

export default App;
