import type { KnownLeads } from '@/types/lead';
import { scrapeGoogleMaps } from './mapsScraper';
import { scrapeGenericPage } from './genericScraper';

try {
  let isExtracting = false;
  console.log('[LeadScraper] Content script loaded on:', window.location.href);

  // ── Main orchestrator ──────────────────────────────────────────────────────
  async function startScrapeProcess(knownLeads?: KnownLeads) {
    const isMaps =
      window.location.hostname.includes('google.com') &&
      window.location.pathname.includes('/maps');
    if (isMaps) {
      await scrapeGoogleMaps(() => isExtracting, knownLeads);
    } else {
      await scrapeGenericPage();
    }
  }

  // ── Message listener ───────────────────────────────────────────────────────
  chrome.runtime.onMessage.addListener((req: any, _sender, sendResponse: any) => {
    try {
      if (req.action === 'PING') {
        sendResponse({ alive: true, url: window.location.href });
        return true;
      }
      if (req.action === 'START_SCRAPING') {
        if (isExtracting) {
          sendResponse({ status: 'already_running' });
          return true;
        }
        isExtracting = true;
        startScrapeProcess(req.knownLeads)
          .catch((err) => {
            console.error('[LeadScraper] Error:', err);
            chrome.runtime.sendMessage(
              { type: 'EXTRACTION_ERROR', message: String(err?.message || err) },
              () => {
                if (chrome.runtime.lastError) {
                  /* ignore */
                }
              }
            );
          })
          .finally(() => {
            isExtracting = false;
            chrome.runtime.sendMessage({ type: 'EXTRACTION_DONE' }, () => {
              if (chrome.runtime.lastError) {
                /* ignore */
              }
            });
          });
        sendResponse({ status: 'started' });
        return true;
      }
      if (req.action === 'STOP_EXTRACTION') {
        isExtracting = false;
        sendResponse({ status: 'stopped' });
        return true;
      }
    } catch (e) {
      console.warn('[LeadScraper] Listener error:', e);
    }
  });
} catch (globalErr) {
  console.warn('[LeadScraper] Init error:', globalErr);
}
</file>

<file path="src/content/mapsScraper.ts">
import type { Lead, KnownLeads } from '@/types/lead';
import { generateLeadId } from '@/types/lead';
import { normalizeUrl } from '@/lib/url';
import {
  waitFor,
  waitForPanelUpdate,
  getDetailPanelH1,
  parseCardName,
  extractPhoneFromElement,
  extractWebsiteFromElement,
  extractAddressFromElement,
  cleanAddressText,
  saveLead,
  jitter,
  EMAIL_REGEX,
  getFtid,
  waitForDetailReady,
  isVisible,
  extractFacebook,
  normalizeName,
} from './domUtils';

export {
  waitForPanelUpdate,
  getDetailPanelH1,
};

export const DEBUG = true;

// Detect actual scrollable container dynamically
export function getScrollContainer(el: HTMLElement): HTMLElement {
  let current: HTMLElement | null = el;
  const docBody = typeof document !== 'undefined' ? document.body : null;
  while (current && current !== docBody) {
    if (typeof window !== 'undefined' && typeof window.getComputedStyle === 'function') {
      const style = window.getComputedStyle(current);
      const overflowY = style.overflowY;
      const isScrollable = (overflowY === 'auto' || overflowY === 'scroll') && current.scrollHeight > current.clientHeight;
      if (isScrollable) return current;
    } else {
      if (current.scrollHeight > current.clientHeight) return current;
    }
    current = current.parentElement;
  }
  return el.scrollHeight > el.clientHeight ? el : (el.parentElement as HTMLElement) || el;
}

// Extract place ID from Google Maps URL for reliable tracking
export function getPlaceId(href: string): string {
  const ftid = getFtid(href);
  if (ftid) return ftid;
  try {
    const match = href.match(/\/maps\/place\/([^/]+)/);
    if (match) return decodeURIComponent(match[1]);
  } catch {
    /* ignore URI decode errors */
  }
  return href;
}

// ── Extract full lead from detail panel ───────────────────────────────────
export function extractFromDetailPanel(pane?: HTMLElement | null): Lead {
  const emptyLead: Lead = { id: '', source: 'Google Maps', name: '', phone: '', email: '', website: '', address: '' };
  if (!pane) return emptyLead;

  // Name
  const ariaLabel = pane.getAttribute('aria-label')?.trim();
  const h1Text = pane.querySelector('h1')?.textContent?.trim();
  const name = ariaLabel || h1Text || '';

  // Phone
  const phone = extractPhoneFromElement(pane);

  // Website & Facebook
  const rawWebsite = extractWebsiteFromElement(pane);
  const facebookUrl = extractFacebook(rawWebsite);
  const website = facebookUrl ? '' : rawWebsite;
  const facebook = facebookUrl || undefined;

  // Address
  const addrEl = pane.querySelector(
    '[data-item-id="address"], button[aria-label*="address" i], button[aria-label*="ঠিকানা" i]'
  );
  let address = '';
  if (addrEl) {
    const raw = addrEl.getAttribute('aria-label') || addrEl.textContent || '';
    address = cleanAddressText(raw);
  }

  // Email on Maps panel (if listed)
  let email = '';
  const paneText = pane.textContent || '';
  const emailMatches = paneText.match(EMAIL_REGEX);
  if (emailMatches) {
    const validEmail = emailMatches.find(
      (e) => !e.endsWith('.png') && !e.endsWith('.jpg') && !e.endsWith('.js') && !e.endsWith('.webp')
    );
    if (validEmail) email = validEmail;
  }

  return {
    id: generateLeadId(),
    source: 'Google Maps',
    name,
    phone,
    email,
    website,
    address,
    ...(facebook ? { facebook } : {}),
  };
}

// ── Google Maps Scraper ────────────────────────────────────────────────────
export async function scrapeGoogleMaps(
  checkActive: () => boolean,
  knownLeads?: KnownLeads
): Promise<void> {
  console.log('[LeadScraper] Starting Google Maps extraction...');

  const knownPhoneDigitsSet = new Set<string>(knownLeads?.phoneDigits || []);
  const knownNamesSet = new Set<string>(knownLeads?.normalizedNames || []);
  const knownWebsitesSet = new Set<string>(knownLeads?.websites || []);

  // Wait for results feed
  let feed: Element | null = await waitFor('div[role="feed"]', 12000, checkActive);
  if (!feed) {
    feed =
      document.querySelector('div[aria-label*="Results" i]') ||
      document.querySelector('div[aria-label*="ফলাফল" i]') ||
      document.querySelector('div.m6QEdf[aria-label]') ||
      document.querySelector('div.m6QEdf');
  }

  if (!feed) {
    // Single place view fallback
    const mains = Array.from(document.querySelectorAll<HTMLElement>('[role="main"]'))
      .filter((m) => isVisible(m) && !m.querySelector('[role="feed"]'));
    const singlePane = mains[0] || null;
    const singleLead = extractFromDetailPanel(singlePane);
    if (singleLead?.name) {
      saveLead(singleLead);
      return;
    }
    chrome.runtime.sendMessage(
      {
        type: 'EXTRACTION_ERROR',
        message: 'Google Maps search results not found. Please open a search page first.',
      },
      () => {
        if (chrome.runtime.lastError) {
          /* ignore */
        }
      }
    );
    return;
  }

  const scrollContainer = getScrollContainer(feed as HTMLElement);

  await jitter(1000, 1500);

  // Track processed places by their unique place-ID in href
  const processedIds = new Set<string>();
  let stuckCount = 0;
  let lastScrollTop = -1;

  while (checkActive()) {
    // Collect unprocessed result cards directly from scrollContainer
    const allAnchors = Array.from(
      scrollContainer.querySelectorAll<HTMLAnchorElement>('a[href*="/maps/place/"]')
    );

    // Deduplicate by extracting the place CID/ID from the URL
    const newAnchors = allAnchors.filter((a) => {
      const id = getPlaceId(a.href);
      return id && !processedIds.has(id);
    });

    if (!checkActive()) break;

    if (newAnchors.length === 0) {
      // Humanized dynamic scroll increment (400px–750px)
      const currentScroll = scrollContainer.scrollTop;
      const scrollDelta = Math.floor(Math.random() * (750 - 400 + 1)) + 400;
      scrollContainer.scrollTop += scrollDelta;
      await jitter(1500, 2200);

      if (!checkActive()) break;

      if (Math.abs(scrollContainer.scrollTop - currentScroll) < 10 || scrollContainer.scrollTop === lastScrollTop) {
        stuckCount++;
        const endText = scrollContainer.textContent || '';
        if (
          endText.includes("You've reached the end") ||
          endText.includes('তালিকায় আর কোনো স্থান নেই') ||
          stuckCount >= 5
        ) {
          console.log('[LeadScraper] Reached end of list.');
          break;
        }
      } else {
        stuckCount = 0;
      }
      lastScrollTop = scrollContainer.scrollTop;
      continue;
    }

    stuckCount = 0;

    for (const anchor of newAnchors) {
      if (!checkActive()) break;

      const placeId = getPlaceId(anchor.href);
      if (!placeId || processedIds.has(placeId)) continue;
      processedIds.add(placeId);

      // ── Step 1: Resilient Name Parsing (clean parser, no broken double-split) ──
      const rawLabel = anchor.getAttribute('aria-label') || '';
      const cardName = parseCardName(rawLabel) || parseCardName(anchor.textContent || '');
      const expectedName = cardName;

      // ── Step 2: Get card-level data without clicking ──
      const cardContainer =
        anchor.closest('div.Nv251d, div[jsaction*="mouseover"], div[role="article"]') ||
        anchor.parentElement?.parentElement ||
        anchor.parentElement;

      const cardPhone = cardContainer ? extractPhoneFromElement(cardContainer as HTMLElement) : '';
      const rawCardWebsite = cardContainer ? extractWebsiteFromElement(cardContainer as HTMLElement) : '';
      const cardFacebook = extractFacebook(rawCardWebsite);
      const cardWebsite = cardFacebook ? '' : rawCardWebsite;
      const cardAddress = cardContainer ? extractAddressFromElement(cardContainer as HTMLElement) : '';

      // ── Resumable Incremental Continuation: Skip already-saved places ──
      const cardPhoneDigits = (cardPhone || '').replace(/\D/g, '');
      if (cardPhoneDigits.length >= 7 && knownPhoneDigitsSet.has(cardPhoneDigits)) {
        console.log(`[LeadScraper] Skipping already-saved lead (phone match): ${cardName}`);
        continue;
      }

      const normName = normalizeName(cardName);
      const normCardWeb = normalizeUrl(cardWebsite || cardFacebook || '');
      if (normName && knownNamesSet.has(normName)) {
        if (normCardWeb.length > 6 && knownWebsitesSet.has(normCardWeb)) {
          console.log(`[LeadScraper] Skipping already-saved lead (name+web match): ${cardName}`);
          continue;
        }
      }

      // ── Step 3: Click with retry loop (up to 3 attempts) ──
      let readyResult = {
        pane: null as HTMLElement | null,
        titleMatched: false,
        urlMatched: false,
        rows: [] as string[],
        waitedMs: 0,
      };
      let attempts = 0;

      for (let attempt = 1; attempt <= 3 && checkActive(); attempt++) {
        attempts = attempt;

        try {
          anchor.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } catch {
          /* ignore scroll errors */
        }
        await jitter(200, 400);
        if (!checkActive()) break;

        const mouseOpts = { bubbles: true, cancelable: true, view: window };
        anchor.dispatchEvent(new MouseEvent('mousedown', mouseOpts));
        anchor.dispatchEvent(new MouseEvent('mouseup', mouseOpts));
        anchor.click();

        if (cardContainer && cardContainer !== anchor) {
          cardContainer.dispatchEvent(new MouseEvent('mousedown', mouseOpts));
          cardContainer.dispatchEvent(new MouseEvent('mouseup', mouseOpts));
        }

        readyResult = await waitForDetailReady(expectedName, {
          anchorHref: anchor.href,
          checkActive,
        });

        if (readyResult.titleMatched && readyResult.urlMatched && readyResult.rows.length > 0) {
          break;
        }

        if (attempt < 3 && checkActive()) {
          await jitter(800, 1500);
        }
      }

      if (!checkActive()) break;

      // ── Step 4: Verification & Merging ──
      const isVerified =
        readyResult.titleMatched &&
        readyResult.urlMatched &&
        readyResult.rows.length > 0 &&
        !!readyResult.pane;

      const detail: Lead = isVerified
        ? extractFromDetailPanel(readyResult.pane)
        : { id: '', source: 'Google Maps', name: '', phone: '', email: '', website: '', address: '' };

      const finalName = (isVerified && detail.name) ? detail.name : cardName;
      const finalPhone = (isVerified && detail.phone) ? detail.phone : cardPhone;
      const rawWeb = (isVerified && detail.website) ? detail.website : cardWebsite;
      const isFb = Boolean(extractFacebook(rawWeb));
      const finalFacebook = (isVerified && detail.facebook)
        ? detail.facebook
        : (isFb ? rawWeb : cardFacebook || undefined);
      const finalWebsite = isFb ? '' : rawWeb;
      const finalAddress = (isVerified && detail.address) ? detail.address : cardAddress;
      const finalEmail = (isVerified && detail.email) ? detail.email : '';

      const lead: Lead = {
        id: generateLeadId(),
        source: 'Google Maps',
        name: finalName,
        phone: finalPhone,
        email: finalEmail,
        website: finalWebsite,
        address: finalAddress,
        ...(finalFacebook ? { facebook: finalFacebook } : {}),
      };

      const source = {
        phone: (isVerified && detail.phone) ? 'detail' : cardPhone ? 'card' : '',
        website: (isVerified && (detail.website || detail.facebook)) ? 'detail' : (cardWebsite || cardFacebook) ? 'card' : '',
        address: (isVerified && detail.address) ? 'detail' : cardAddress ? 'card' : '',
      };

      if (DEBUG) {
        console.log('[LeadScraper][DEBUG]', {
          name: finalName,
          attempts,
          paneFound: readyResult.titleMatched,
          urlMatched: readyResult.urlMatched,
          rowIds: readyResult.rows,
          waitedMs: readyResult.waitedMs,
          source,
        });
      }

      if (lead.name) {
        console.log('[LeadScraper] Lead:', lead.name, '| phone:', lead.phone, '| web:', lead.website);
        saveLead(lead);

        // Add newly collected identifiers to prevent re-visiting on dynamic page re-renders
        const pDigits = (lead.phone || '').replace(/\D/g, '');
        if (pDigits.length >= 7) knownPhoneDigitsSet.add(pDigits);
        const nName = normalizeName(lead.name);
        if (nName) knownNamesSet.add(nName);
        const w1 = normalizeUrl(lead.website || '');
        if (w1.length > 6) knownWebsitesSet.add(w1);
        const w2 = normalizeUrl(lead.facebook || '');
        if (w2.length > 6) knownWebsitesSet.add(w2);
      }

      if (isVerified) {
        await jitter(300, 800);
      }
      await jitter(200, 400);
    }
  }

  console.log('[LeadScraper] Extraction finished. Total processed places:', processedIds.size);
}
