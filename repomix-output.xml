          <Loader2 className="h-4 w-4 animate-spin shrink-0 text-[#c6f432]" />
          <span>Navigating & Extracting… {leadsCount} lead{leadsCount !== 1 ? 's' : ''} collected</span>
        </div>
      )}
    </div>
  );
}
